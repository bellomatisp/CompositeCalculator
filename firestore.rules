rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user reads/writes only his own library
    match /libraries/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
